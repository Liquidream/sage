{
  "name": "sage",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "test:unit": "vitest --environment jsdom",
    "build play": "vite build --config vite.config.play.mts --outDir dist-play && copy /y \"dist-play\\entry-index-play.js\" \"public\" && copy /y \"dist-play\\SAGE.css\" \"public\"",
    "build edit": "vite build --outDir dist-edit",
    "serve edit": "vite preview --outDir dist-edit",
    "build github": "vite build --base=/sage/",
    "deploy github": "gh-pages -d dist",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false"
  },
  "dependencies": {
    "@mdi/font": "7.4.47",
    "@pixi/sound": "^6.0.1",
    "@pixi/utils": "^7.4.3",
    "@rollup/plugin-replace": "^6.0.2",
    "@vueuse/core": "^13.7.0",
    "ace-builds": "^1.43.2",
    "file-saver": "^2.0.5",
    "inkjs": "^2.3.2",
    "jszip": "^3.10.1",
    "jszip-utils": "^0.1.0",
    "localforage": "^1.10.0",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate-2": "^2.0.31",
    "pixi-filters": "^6.1.4",
    "pixi.js": "^8.12.0",
    "roboto-fontface": "*",
    "tweedle.js": "^2.1.0",
    "vite-plugin-mkcert": "^1.17.8",
    "vite-plugin-static-copy": "^3.1.1",
    "vue": "^3.5.18",
    "vue3-ace-editor": "^2.2.4",
    "vuetify": "^3.9.5",
    "vuetify-use-dialog": "^0.6.11",
    "webfontloader": "^1.6.28"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.12.0",
    "@tsconfig/node18": "^18.2.4",
    "@types/file-saver": "^2.0.7",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.3.0",
    "@types/webfontloader": "^1.6.38",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.33.0",
    "eslint-plugin-vue": "^10.4.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^26.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.0.2",
    "vite-plugin-vuetify": "^2.1.2",
    "vitest": "^3.2.4",
    "vue-cli-plugin-vuetify": "~2.5.8",
    "vue-tsc": "^3.0.5"
  }
}

{
  "name": "sage",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "test:unit": "vitest --environment jsdom",
    "build play": "vite build --config vite.config.play.ts --outDir dist-play && copy /y \"dist-play\\entry-index-play.js\" \"public\" && copy /y \"dist-play\\SAGE.css\" \"public\"",
    "build edit": "vite build --outDir dist-edit",
    "serve edit": "vite preview --outDir dist-edit",
    "build github": "vite build --base=/sage/",
    "deploy github": "gh-pages -d dist",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false"
  },
  "dependencies": {
    "@mdi/font": "7.4.47",
    "@pixi/sound": "^6.0.0",
    "@pixi/utils": "^7.4.2",
    "@rollup/plugin-replace": "^5.0.7",
    "@vueuse/core": "^10.10.0",
    "ace-builds": "^1.34.2",
    "file-saver": "^2.0.5",
    "inkjs": "^2.2.3",
    "jszip": "^3.10.1",
    "jszip-utils": "^0.1.0",
    "localforage": "^1.10.0",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate-2": "^2.0.18",
    "pixi-filters": "^6.0.4",
    "pixi.js": "^8.1.6",
    "roboto-fontface": "*",
    "tweedle.js": "^2.1.0",
    "vite-plugin-mkcert": "^1.17.5",
    "vite-plugin-static-copy": "^1.0.5",
    "vue": "^3.4.27",
    "vue3-ace-editor": "^2.2.4",
    "vuetify": "^3.6.8",
    "webfontloader": "^1.6.28"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.10.3",
    "@tsconfig/node18": "^18.2.4",
    "@types/file-saver": "^2.0.7",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.14.2",
    "@types/webfontloader": "^1.6.38",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^9.4.0",
    "eslint-plugin-vue": "^9.26.0",
    "gh-pages": "^6.1.1",
    "jsdom": "^24.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.1",
    "typescript": "~5.4.5",
    "vite": "^5.2.13",
    "vite-plugin-pwa": "^0.20.0",
    "vite-plugin-vuetify": "^2.0.3",
    "vitest": "^1.6.0",
    "vue-cli-plugin-vuetify": "~2.5.8",
    "vue-tsc": "^2.0.21"
  }
}
